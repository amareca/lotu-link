{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOTU Link",
  "version": "0.1.0",
  "identifier": "com.lotulink.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOTU Link",
        "width": 840,
        "height": 900,
        "minWidth": 480,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "amareca",
    "shortDescription": "Mira y controla un Android por USB",
    "licenseFile": "../LICENSE",
    "resources": [
      "resources/scrcpy-server.jar",
      "resources/adb/adb.exe",
      "resources/adb/AdbWinApi.dll",
      "resources/adb/AdbWinUsbApi.dll",
      "licenses/scrcpy/LICENSE",
      "licenses/scrcpy/NOTICE",
      "licenses/adb/LICENSE",
      "../THIRD_PARTY_NOTICES.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
